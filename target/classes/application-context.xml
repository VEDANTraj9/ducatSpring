<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<bean name="add" class="com.ducat.Spring.model.Address">
		<property name="city" value="Rajgir" />
		<property name="state" value="Bihar" />
	</bean>

	<bean name="e1" class="com.ducat.Spring.model.Employee"
		autowire="constructor">
		<constructor-arg name="name" value="Ansh" />
		<constructor-arg name="gender" value="Male" />
		<constructor-arg name="id" value="101" />


	</bean>


</beans>